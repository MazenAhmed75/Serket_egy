@page
@model ECommerceStore.Web.Areas.Admin.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="admin-login">
    <h1>Sign in</h1>

    <form method="post">
        @if (Model.ErrorMessage is not null)
        {
            <p class="field-error">@Model.ErrorMessage</p>
        }

        <label asp-for="Input.Username"></label>
        <input asp-for="Input.Username" type="text" autocomplete="username" />
        <span asp-validation-for="Input.Username" class="field-error"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>

        <button type="submit" class="btn-primary">Sign in</button>
    </form>
</section>
