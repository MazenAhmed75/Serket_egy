@page
@model ECommerceStore.Web.Areas.Admin.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>
<p class="hint">Each product below is a card on the home page and has its own product page. Open one to change its photo, price, description, colours and stock.</p>

@if (Model.StatusMessage is not null)
{
    <p class="status-message">@Model.StatusMessage</p>
}

@if (Model.CanAddStarterFabrics)
{
    <section class="details-panel">
        <h2>Starter fabrics</h2>
        <p class="hint">Adds the three fabrics the store launches with (Rozalin, antibacterial, and waterproof antibacterial) with descriptions and prices. Fabrics you already have are skipped. They start with a placeholder photo and 10 units per size.</p>
        <form method="post" asp-page-handler="AddStarterFabrics">
            <button type="submit" class="btn-primary">Add the starter fabrics</button>
        </form>
    </section>
}

@if (Model.Rows.Count == 0)
{
    <p class="hint">No products yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="admin-table products-table">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Order</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><img src="@row.ImageUrl" alt="" class="color-photo-thumb" /></td>
                        <td>
                            <strong>@row.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(row.ShortDescription))
                            {
                                <br /><span class="hint">@row.ShortDescription</span>
                            }
                        </td>
                        <td>@row.Price.ToString("N2") EGP</td>
                        <td>@row.SortOrder</td>
                        <td>@(row.TotalStock > 0 ? $"{row.TotalStock} units" : "Sold out")</td>
                        <td>@(row.IsActive ? "Visible" : "Hidden")</td>
                        <td class="promo-actions">
                            <a asp-page="./Edit" asp-route-id="@row.Id">Edit</a>
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@row.Id" class="inline-form">
                                <button type="submit" class="link-button">@(row.IsActive ? "Hide" : "Show")</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@row.Id" class="inline-form"
                                  data-confirm="Delete this product? This cannot be undone.">
                                <button type="submit" class="link-button-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<section class="details-panel">
    <h2>Add a product</h2>
    <form method="post" asp-page-handler="Create" enctype="multipart/form-data" class="checkout-form">
        <div asp-validation-summary="All" class="validation-summary"></div>

        <label asp-for="Input.Name"></label>
        <input asp-for="Input.Name" type="text" />
        <span asp-validation-for="Input.Name" class="field-error"></span>

        <label asp-for="Input.ShortDescription"></label>
        <input asp-for="Input.ShortDescription" type="text" maxlength="200" />
        <span asp-validation-for="Input.ShortDescription" class="field-error"></span>

        <label asp-for="Input.Description"></label>
        <textarea asp-for="Input.Description" rows="4"></textarea>
        <span asp-validation-for="Input.Description" class="field-error"></span>

        <label asp-for="Input.Price"></label>
        <input asp-for="Input.Price" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Input.Price" class="field-error"></span>

        <label asp-for="Input.ImageFile"></label>
        <input asp-for="Input.ImageFile" type="file" accept="image/jpeg,image/png,image/webp" />
        <span asp-validation-for="Input.ImageFile" class="field-error"></span>

        <button type="submit" class="btn-primary">Create product</button>
    </form>
</section>
