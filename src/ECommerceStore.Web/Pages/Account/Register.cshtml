@page
@model ECommerceStore.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<section class="auth-card">
    <h1>Create your account</h1>
    <p class="hint">An account saves your details for faster checkout and lets you use promo codes. You can still order without one.</p>

    <form method="post" class="checkout-form">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label asp-for="Input.FullName"></label>
        <input asp-for="Input.FullName" type="text" autocomplete="name" />
        <span asp-validation-for="Input.FullName" class="field-error"></span>

        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" type="email" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="field-error"></span>

        <label asp-for="Input.PhoneNumber"></label>
        <input asp-for="Input.PhoneNumber" type="tel" autocomplete="tel" />
        <span asp-validation-for="Input.PhoneNumber" class="field-error"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>

        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

        <button type="submit" class="btn-primary btn-cta">Create account</button>
    </form>

    <p class="auth-switch">Already have an account? <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
</section>
