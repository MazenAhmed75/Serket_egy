@page
@model ECommerceStore.Web.Pages.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}

@if (Model.Product is null)
{
    <p>Redirecting…</p>
}
else
{
    var p = Model.Product;
    var summaryImage = !string.IsNullOrEmpty(Model.SelectedColor?.ImageUrl) ? Model.SelectedColor!.ImageUrl : p.ImageUrl;
    var pr = Model.Pricing;
    <section class="checkout">
        <div class="checkout-header-area">
            <a href="@Model.ChangeSelectionUrl" class="back-link">&larr; Back to product</a>
            <h1>Express Checkout</h1>
            <div class="checkout-steps-bar">
                <span class="step-indicator active"><span class="step-num">1</span> Order Details</span>
                <span class="step-sep">&rsaquo;</span>
                <span class="step-indicator active"><span class="step-num">2</span> Delivery Pin</span>
                <span class="step-sep">&rsaquo;</span>
                <span class="step-indicator active"><span class="step-num">3</span> Payment</span>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-img-box">
                <img src="@summaryImage" alt="@p.Name" />
            </div>
            <div class="summary-details">
                <span class="summary-kicker">Order Item</span>
                <h2>@p.Name</h2>
                <div class="summary-meta">
                    <span class="quality-badge"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> In Stock &amp; Ready to Ship</span>
                </div>
                <div class="selection-chips">
                    <span class="selection-chip">@(Model.Input.Gender == "Female" ? "Women's Fit" : "Men's Fit")</span>
                    <span class="selection-chip">Size @Model.Input.Size</span>
                    @if (Model.SelectedColor is not null)
                    {
                        <span class="selection-chip">
                            <span class="chip-swatch" style="--swatch-color: @Model.SelectedColor.HexCode"></span>@Model.SelectedColor.Name
                        </span>
                    }
                    <span class="selection-chip">Qty @Model.Input.Quantity</span>
                    <a href="@Model.ChangeSelectionUrl" class="change-selection">Change</a>
                </div>
            </div>

            <!-- Price in three parts: items, shipping, total (plus a discount line when a promo code takes a percentage off). -->
            <div class="price-breakdown" id="priceBreakdown">
                <div class="price-line">
                    <span>Items (@Model.Input.Quantity &times; @p.CurrentPrice.ToString("N2") EGP@(p.HasDiscount ? $", {p.DiscountPercent}% off" : ""))</span>
                    <span id="pb-subtotal">@CheckoutModel.Money(pr.Subtotal)</span>
                </div>
                <div class="price-line price-line-discount" id="pb-discount-row" hidden="@(pr.Discount <= 0)">
                    <span>Discount (<span id="pb-promo-label">@pr.PromoCode @(pr.PercentOff > 0 ? $"- {pr.PercentOff}%" : "")</span>)</span>
                    <span id="pb-discount">-@CheckoutModel.Money(pr.Discount)</span>
                </div>
                <div class="price-line">
                    <span>Shipping</span>
                    <span id="pb-shipping" class="@(pr.Shipping <= 0 ? "free" : "")">@CheckoutModel.ShippingText(pr.Shipping)</span>
                </div>
                <div class="price-line price-line-total">
                    <span>Total</span>
                    <span id="pb-total">@CheckoutModel.Money(pr.Total)</span>
                </div>
            </div>
        </div>

        <!-- Promo code box (needs a logged-in account: each code can be used once per account) -->
        <div class="promo-card" id="promoCard">
            <span class="summary-kicker">Promo code</span>
            @if (Model.IsLoggedIn)
            {
                <div class="promo-row">
                    <input type="text" id="promoInput" placeholder="Enter promo code" autocomplete="off" maxlength="50" value="@Model.Input.PromoCode" />
                    <button type="button" class="btn-primary promo-apply" id="promoApply">Apply</button>
                </div>
                <p class="promo-message" id="promoMessage" role="status"></p>
            }
            else
            {
                <p class="hint">
                    Have a promo code? <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(Model.CheckoutUrl)">Log in</a>
                    or <a href="/Account/Register?returnUrl=@Uri.EscapeDataString(Model.CheckoutUrl)">create an account</a> to use it.
                </p>
            }
        </div>

        <form method="post" enctype="multipart/form-data" class="checkout-form">
            <input asp-for="Input.ProductId" type="hidden" />
            <input asp-for="Input.PromoCode" type="hidden" />

            <div asp-validation-summary="All" class="validation-summary"></div>

            <fieldset>
                <legend>Your details</legend>

                <label asp-for="Input.CustomerFullName"></label>
                <input asp-for="Input.CustomerFullName" type="text" autocomplete="name" />
                <span asp-validation-for="Input.CustomerFullName" class="field-error"></span>

                <label asp-for="Input.CustomerPhoneNumber"></label>
                <input asp-for="Input.CustomerPhoneNumber" type="tel" autocomplete="tel" />
                <span asp-validation-for="Input.CustomerPhoneNumber" class="field-error"></span>

                <label asp-for="Input.CustomerEmail"></label>
                @if (Model.IsLoggedIn)
                {
                    <input asp-for="Input.CustomerEmail" type="email" autocomplete="email" readonly="readonly" />
                }
                else
                {
                    <input asp-for="Input.CustomerEmail" type="email" autocomplete="email" />
                }
                <span asp-validation-for="Input.CustomerEmail" class="field-error"></span>

                @* Gender, size, colour and quantity are chosen on the product page; checkout only confirms them. *@
                <input asp-for="Input.Gender" type="hidden" />
                <input asp-for="Input.Size" type="hidden" />
                <input asp-for="Input.ProductColorId" type="hidden" />
                <input asp-for="Input.Quantity" type="hidden" />
                <span asp-validation-for="Input.Quantity" class="field-error"></span>
                <span asp-validation-for="Input.ProductColorId" class="field-error"></span>
            </fieldset>

            <fieldset>
                <legend>Delivery location</legend>
                <p class="hint">Tap or drag the pin to your exact delivery location, or let your phone find where you are.</p>
                <button type="button" class="locate-button" id="use-my-location">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>
                    Use my current location
                </button>
                <p class="hint locate-error" id="locate-error" role="alert" hidden></p>
                <div id="delivery-map"></div>
                <p id="location-status" class="hint location-status">No location selected yet — tap the map to drop a pin.</p>
                <input asp-for="Input.Latitude" type="hidden" id="Input_Latitude" />
                <input asp-for="Input.Longitude" type="hidden" id="Input_Longitude" />

                <div class="address-row">
                    <div>
                        <label asp-for="Input.Governorate"></label>
                        <select asp-for="Input.Governorate" autocomplete="off">
                            <option value="">Choose governorate</option>
                            @foreach (var governorate in Model.Governorates)
                            {
                                <option value="@governorate" selected="@(governorate == Model.Input.Governorate)">@governorate</option>
                            }
                        </select>
                        <span asp-validation-for="Input.Governorate" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Input.Area"></label>
                        <input asp-for="Input.Area" type="text" autocomplete="off" placeholder="e.g. Maadi, Nasr City" />
                        <span asp-validation-for="Input.Area" class="field-error"></span>
                    </div>
                </div>

                <div class="address-row address-row-street">
                    <div>
                        <label asp-for="Input.Street"></label>
                        <input asp-for="Input.Street" type="text" autocomplete="off" placeholder="e.g. Road 9" />
                        <span asp-validation-for="Input.Street" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Input.BuildingNumber"></label>
                        <input asp-for="Input.BuildingNumber" type="text" autocomplete="off" placeholder="e.g. 12" />
                        <span asp-validation-for="Input.BuildingNumber" class="field-error"></span>
                    </div>
                </div>

                <label asp-for="Input.AddressDetail"></label>
                <textarea asp-for="Input.AddressDetail" rows="3" autocomplete="off" placeholder="Floor, apartment, nearest landmark… (optional)"></textarea>
                <span asp-validation-for="Input.AddressDetail" class="field-error"></span>
            </fieldset>

            <fieldset>
                <legend>Payment method</legend>

                <div class="payment-options">
                    <label class="payment-option">
                        <input type="radio" asp-for="Input.PaymentMethod" value="CashOnDelivery" checked />
                        <span class="pay-icon-wrapper">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                        </span>
                        <span class="pay-title">Cash on delivery</span>
                        <span class="pay-desc">Pay upon doorstep arrival</span>
                    </label>
                    <label class="payment-option">
                        <input type="radio" asp-for="Input.PaymentMethod" value="VodafoneCash" />
                        <span class="pay-icon-wrapper">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                        </span>
                        <span class="pay-title">Vodafone Cash</span>
                        <span class="pay-desc">Mobile wallet transfer</span>
                    </label>
                    <label class="payment-option">
                        <input type="radio" asp-for="Input.PaymentMethod" value="InstaPay" />
                        <span class="pay-icon-wrapper">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span class="pay-title">InstaPay</span>
                        <span class="pay-desc">Instant bank network</span>
                    </label>
                </div>

                <div id="receipt-section" class="receipt-section" hidden>
                    <div class="receipt-banner">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                        <div>
                            <p class="hint" data-method="VodafoneCash">
                                Transfer to Vodafone Cash number: <strong>@Model.VodafoneCashNumber</strong>. Please attach your confirmation screenshot or SMS reference.
                            </p>
                            <p class="hint" data-method="InstaPay">
                                Transfer to InstaPay IPA handle: <strong>@Model.InstaPayHandle</strong>. Please attach your payment success screenshot or transaction ID.
                            </p>
                        </div>
                    </div>

                    <div class="upload-dropzone">
                        <label asp-for="Input.ReceiptFile" class="file-label">
                            <span class="file-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></span>
                            <span class="file-prompt">Click to select receipt screenshot</span>
                            <span class="file-meta">PNG, JPG, or WEBP up to 5MB</span>
                        </label>
                        <input asp-for="Input.ReceiptFile" type="file" accept="image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="Input.ReceiptFile" class="field-error"></span>
                    </div>

                    <label asp-for="Input.TransactionReference">Transaction Reference / Sender Number (Optional)</label>
                    <input asp-for="Input.TransactionReference" type="text" placeholder="e.g. 010xxxxxxxx or Reference #123456" />
                    <span asp-validation-for="Input.TransactionReference" class="field-error"></span>
                </div>
            </fieldset>

            <div class="checkout-submit-area">
                <button type="submit" class="btn-primary btn-cta">
                    <span>Confirm &amp; Place Order</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
                <div class="checkout-guarantees">
                    <span><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> 100% Satisfaction Guarantee</span>
                    <span><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Inspect Package on Delivery</span>
                </div>
            </div>
        </form>
    </section>
}

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/checkout-map.js" asp-append-version="true"></script>
    <script src="~/js/checkout-promo.js" asp-append-version="true"></script>
}
