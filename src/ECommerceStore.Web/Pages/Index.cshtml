@page
@model ECommerceStore.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Serket";
}

<section class="home-hero">
    <span class="hero-kicker">Serket Medical Apparel</span>
    <p class="hero-title">Scrubs made for the long shift</p>
    <p class="hero-lead">Pick the fabric that suits your shift, choose your fit, size and colour, drop a pin for your delivery, and pay the way that suits you. No account needed.</p>
    <div class="hero-actions">
        <a href="#products" class="btn-primary hero-btn">Shop the scrubs</a>
        <a href="#faq" class="hero-link">Questions? Read the FAQ &darr;</a>
    </div>
</section>

<section class="catalog" id="products">
    <div class="section-badge-header">
        <span class="section-kicker">Our fabrics</span>
        <h2>Choose your fabric</h2>
        <p class="section-lead">Each fabric has its own feel and price. Pick one to see its colours, sizes and details.</p>
    </div>

    @if (Model.Products.Count == 0)
    {
        <p class="hint catalog-empty">Our scrubs are coming soon. Please check back shortly.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var card in Model.Products)
            {
                <a asp-page="/Product" asp-route-slug="@card.Slug" class="product-card">
                    <div class="product-card-media">
                        <img src="@card.ImageUrl" alt="@card.Name" loading="lazy" />
                        @if (card.DiscountPercent > 0)
                        {
                            <span class="discount-banner">-@card.DiscountPercent%</span>
                        }
                        @if (!card.InStock)
                        {
                            <span class="product-card-badge">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                                Sold out
                            </span>
                        }
                    </div>
                    <div class="product-card-body">
                        <h3 class="product-card-title">@card.Name</h3>
                        <partial name="_Stars" model="card.Rating" />
                        @if (!string.IsNullOrWhiteSpace(card.ShortDescription))
                        {
                            <p class="product-card-desc">@card.ShortDescription</p>
                        }
                        @if (card.Swatches.Count > 0)
                        {
                            <div class="product-card-swatches" aria-hidden="true">
                                @foreach (var hex in card.Swatches)
                                {
                                    <span class="card-swatch" style="--swatch-color: @hex"></span>
                                }
                            </div>
                        }
                        <p class="product-card-price">
                            @card.Price.ToString("N2") <small>EGP</small>
                            @if (card.DiscountPercent > 0)
                            {
                                <span class="price-original">@card.OriginalPrice.ToString("N2")</span>
                            }
                        </p>
                    </div>
                </a>
            }
        </div>
    }
</section>

    <section class="features" id="features">
        <div class="section-badge-header">
            <span class="section-kicker">Engineered For Performance</span>
            <h2>Made for a full shift on your feet</h2>
            <p class="section-lead">Every seam, stitch, and fabric blend was designed with the direct feedback of practicing physicians, nurses, and surgeons.</p>
        </div>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon-box">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
                </div>
                <h3>Choose your fabric</h3>
                <p>Rozalin for soft, lightweight comfort, antibacterial for a soft everyday fabric, or waterproof antibacterial when you want both.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon-box">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3>Reinforced Seams</h3>
                <p>Double-stitched at high-stress points so pocket joins, bar tacks, and inseams never tear during continuous wear.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon-box">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                </div>
                <h3>Precision Tailored Fit</h3>
                <p>V-neck top with deep utility pockets plus straight-leg drawstring pants with secure phone holster.</p>
            </div>
        </div>
    </section>

    <section class="how-it-works" id="how-it-works">
        <div class="section-badge-header">
            <span class="section-kicker">Simple &amp; Direct</span>
            <h2>How ordering works</h2>
            <p class="section-lead">Zero unnecessary account sign-ups. Complete your purchase in under 60 seconds.</p>
        </div>
        <ol class="steps">
            <li class="step-card">
                <div class="step-badge">1</div>
                <div class="step-content">
                    <h3>Choose Fabric, Fit &amp; Size</h3>
                    <p>Pick the fabric you want, then choose your tailored fit, size and colour on its page using the interactive measurement guide.</p>
                </div>
            </li>
            <li class="step-card">
                <div class="step-badge">2</div>
                <div class="step-content">
                    <h3>Pin Your Map Location</h3>
                    <p>Drop a pin on our interactive map so our courier delivers directly to your specific building door.</p>
                </div>
            </li>
            <li class="step-card">
                <div class="step-badge">3</div>
                <div class="step-content">
                    <h3>Pay Your Preferred Way</h3>
                    <p>Pay upon arrival in cash, or securely via Vodafone Cash or InstaPay with immediate receipt verification.</p>
                </div>
            </li>
        </ol>
    </section>

<partial name="_Faq" />
