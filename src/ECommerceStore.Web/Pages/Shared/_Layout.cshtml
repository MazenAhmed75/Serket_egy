<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Serket</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="header-container">
            <a class="wordmark" href="/" aria-label="Serket Medical Apparel - Home">
                <partial name="_Logo" />
            </a>
            <div class="header-actions">
                <nav class="site-nav">
                    <a href="/#features">Why Serket</a>
                    <a href="/#how-it-works">How it works</a>
                    <a href="/#faq">FAQ</a>
                    <a href="/#products" class="nav-highlight"><span class="nav-dot"></span> Shop scrubs</a>
                </nav>
                <div class="header-divider"></div>
                <div class="account-links">
                    @if (Context.GetCustomerId() is not null)
                    {
                        <span class="account-name">Hi, @(Context.GetCustomerName()?.Split(' ')[0])</span>
                        <form method="post" asp-page="/Account/Logout" class="account-logout">
                            <button type="submit" class="account-link">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="account-link">Log in</a>
                        <a href="/Account/Register" class="account-link account-link-primary">Sign up</a>
                    }
                </div>
                <button type="button" class="theme-toggle" id="themeToggleBtn" aria-label="Toggle light or dark theme" title="Toggle theme">
                    <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                    <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand-section">
                <partial name="_Logo" />
                <p class="footer-tagline">Crafted medical apparel engineered for Egyptian healthcare professionals. Uncompromising fabric comfort, enduring seams, tailored modern fit.</p>
            </div>
            <div class="footer-grid-links">
                <div class="footer-col">
                    <h4>Direct Ordering</h4>
                    <p class="footer-note">Fast doorstep delivery across Greater Cairo and Egypt. Pinpoint map geolocation on checkout.</p>
                </div>
                <div class="footer-col">
                    <h4>Contact us</h4>
                    <ul class="footer-contact">
                        <li><a class="contact-link" href="https://wa.me/SERKET1" target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
                        <li><a class="contact-link" href="https://www.instagram.com/serket.egy?utm_source=qr" target="_blank" rel="noopener noreferrer">Instagram</a></li>
                        <li><a class="contact-link" href="mailto:serket.egy@gmail.com">Email</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Payment Support</h4>
                    <div class="footer-badges">
                        <span class="pay-badge">Cash on Delivery</span>
                        <span class="pay-badge">Vodafone Cash</span>
                        <span class="pay-badge">InstaPay</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="footer-rule"></div>
            <p>&copy; @DateTime.UtcNow.Year Serket Apparel. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
